{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v2/fragment.schema.json",
  "title": "Change Saga fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "media_type", "entrypoint"],
  "properties": {
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "title": { "type": "string" },
    "media_type": {
      "type": "string",
      "pattern": "^(text/(markdown|html|plain)|image/[A-Za-z0-9.+-]+)$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$",
      "not": {
        "anyOf": [
          { "pattern": "(^|/)(\\.\\.?|___[^/]*|fragment\\.json|)(/|$)" },
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "[\\x00-\\x1f\\x7f]" }
        ]
      },
      "description": "Package-relative slash path. Never absolute, never traversing, never a reserved package path, and never containing a backslash, which addresses different files on Windows and Unix."
    },
    "order": { "type": "integer" }
  }
}
