{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v2/diff.schema.json",
  "title": "Change Saga diff links",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "diffs"],
  "properties": {
    "version": { "const": 2 },
    "diffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "pattern": "^saga-diff://v1/(line|event)\\?" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
