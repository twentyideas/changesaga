{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v2/claim.schema.json",
  "title": "Change Saga author claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "target", "kind", "statement", "evidence", "created_at"],
  "properties": {
    "version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "target": { "type": "string", "pattern": "^urn:change-saga:" },
    "kind": {
      "enum": ["behavior", "invariant", "performance", "compatibility", "security", "data", "ux", "test"]
    },
    "statement": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^saga-diff://v1/" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
