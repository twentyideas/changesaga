{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v3/workplan-event.schema.json",
  "title": "Living Saga append-only work-plan event",
  "type": "object",
  "required": ["$schema", "version", "id", "parents", "created_at"],
  "properties": {
    "$schema": {"const": "https://changesaga.dev/schema/v3/workplan-event.schema.json"},
    "version": {"const": 3},
    "id": {"$ref": "#/$defs/id"},
    "parents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^urn:change-saga:"}},
    "created_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_item": {"type": "string"}, "state": {"type": "string"}, "reason": {"type": "string"}, "action": {"enum": ["assigned", "released"]}, "role": {"enum": ["owner", "contributor", "observer"]},
    "workspace": {"$ref": "#/$defs/workspace"}, "unit": {"$ref": "#/$defs/id"}, "head_oid": {"$ref": "#/$defs/oid"}, "merge_oid": {"$ref": "#/$defs/oid"}, "revert_oid": {"$ref": "#/$defs/oid"},
    "contract": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"oneOf": [
      {"required": ["work_item", "state"], "not": {"anyOf": [{"required": ["workspace"]}, {"required": ["unit"]}, {"required": ["contract"]}]}},
      {"required": ["work_item", "action", "role", "workspace"]},
      {"required": ["work_item", "unit", "state"]},
      {"required": ["contract", "state", "evidence"]}
    ]}
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "workspace": {"type": "object", "additionalProperties": false, "required": ["provider", "id", "repository_id", "branch"], "properties": {"provider": {"const": "devswarm"}, "id": {"type": "string", "format": "uuid"}, "repository_id": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "source_branch": {"type": "string"}, "label": {"type": "string"}}}
  }
}
