{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v3/story.schema.json",
  "title": "Living Change Saga story identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "id", "created_at"],
  "properties": {
    "$schema": { "const": "https://changesaga.dev/schema/v3/story.schema.json" },
    "version": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "request_id": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}
